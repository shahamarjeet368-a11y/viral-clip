# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Comma-separated list of exact frontend origins allowed to call this API.
# Wildcard ("*") is rejected at startup - list every origin explicitly.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional: enables Supabase-backed project storage instead of the local
# JSON file store. Leave unset to run in local-storage-only mode.
# Use the SERVICE ROLE key here, not the anon/public key - the backend
# writes as a trusted server process and needs to bypass row-level
# security, which the anon key cannot do (find it in Supabase dashboard
# under Project Settings -> API -> service_role).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional but recommended in production: paste the full contents of a
# cookies.txt file (Netscape format, exported from a browser signed into
# YouTube) here as a platform secret/env var. Without it, YouTube's bot
# detection blocks most downloads from datacenter IPs (Render/Railway/etc),
# even though it usually works fine from a home IP. Never commit a real
# cookies.txt to git - it contains a live session.
YTDLP_COOKIES=

# Optional: URL of a bgutil-ytdlp-pot-provider HTTP server (PO Token
# provider). Helps yt-dlp avoid YouTube format-throttling on top of cookies.
# Leave unset - it defaults to http://127.0.0.1:4416 and silently does
# nothing if no server is listening there, so it's safe either way.
# To actually use it: deploy the `brainicism/bgutil-ytdlp-pot-provider`
# Docker image as a second Render service (Docker Hub image, port 4416),
# then set this to that service's internal URL, e.g.
# http://<render-service-name>:4416
BGUTIL_POT_BASE_URL=
