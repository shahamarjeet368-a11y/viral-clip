# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Comma-separated list of exact frontend origins allowed to call this API.
# Wildcard ("*") is rejected at startup - list every origin explicitly.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional: enables Supabase-backed project storage instead of the local
# JSON file store. Leave unset to run in local-storage-only mode.
SUPABASE_URL=
SUPABASE_KEY=
